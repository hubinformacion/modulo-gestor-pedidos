# Neon Postgres connection string. Use a separate database/branch for tests.
DATABASE_URL=

# Generate a random secret of at least 32 characters; never reuse the example.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth Web application (identity scopes only in phase 1).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Drive/Gmail owner's refresh token and folder are added in phase 4.
# These are NOT required for administrator sign-in.
