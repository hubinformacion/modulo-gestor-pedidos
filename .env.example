# Neon Postgres. Use separate branches for development/review and production.
DATABASE_URL=

# Google OAuth administrator sign-in. No open registration: authorized_emails is authoritative.
# Secret: openssl rand -base64 32 (never commit the generated value).
BETTER_AUTH_SECRET=
# Local: http://localhost:3000. Vercel: the stable HTTPS application origin.
BETTER_AUTH_URL=http://localhost:3000
# Web OAuth client. Register this exact callback for each approved environment:
# <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Owner authorization is separate from administrator identity scopes.
# Enable Drive API and Gmail API. Consent with offline access:
# https://www.googleapis.com/auth/drive https://www.googleapis.com/auth/gmail.send
# https://www.googleapis.com/auth/gmail.metadata (read actual headers to preserve order threads)
# Use the same OAuth client above. Save the refresh token privately.
GOOGLE_REFRESH_TOKEN=
# Sender mailbox belonging to the owner authorized by that refresh token.
GOOGLE_OWNER_EMAIL=
# ID only, not the whole Drive folder link.
GOOGLE_DRIVE_FOLDER_ID=
# Links in order emails. Use the stable HTTPS origin on Vercel.
APP_URL=http://localhost:3000

# Exact parent origins allowed by frame-ancestors AND postMessage.
# Comma-separated HTTPS origins without paths, queries, credentials or wildcards.
# Empty = same-origin embedding only. Changing this requires restart/redeploy.
# Local simulator: http://localhost:3001
# Include www and non-www separately only if both are actual WordPress hosts.
WORDPRESS_ORIGINS=

# Set this in Vercel Project Settings > Environment Variables before deployment
# so Corepack uses the pnpm version declared in package.json.
ENABLE_EXPERIMENTAL_COREPACK=1

# No bank/catalog/campus environment variables: manage them in /admin/configuracion.
# Payment PDF filenames in src/assets/pdfs:
# guia_pago_universidad.pdf, guia_pago_instituto.pdf, guia_pago_mixta.pdf

# Automatic retry of pending order emails and Drive access reconciliation.
# Copy the same private value into Vercel Environment Variables (Production).
# At least 32 random characters; never commit the generated secret.
# The daily cron runs at 12:00 UTC. State changes still send immediately.
CRON_SECRET=

# Confirmed production deployment (set in Vercel Production, keep local values above):
# BETTER_AUTH_URL=https://modulo-gestor-pedidos.vercel.app
# APP_URL=https://modulo-gestor-pedidos.vercel.app
# WORDPRESS_ORIGINS=https://fondoeditorial.continental.edu.pe
# Google production callback:
# https://modulo-gestor-pedidos.vercel.app/api/auth/callback/google
# Setup and operating instructions: README.md

# Optional full WordPress page URL for email tracking links (fragment route).
# The confirmed production domain uses the WordPress page below by default.
# Override this for other deployments/review environments; no query or fragment.
# Local development without this value keeps links on localhost.
WORDPRESS_ORDER_URL=
# Production: https://fondoeditorial.continental.edu.pe/pedido/
