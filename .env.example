# Configuración local: copiar este archivo como .env.local y completar secretos.
# Ambos archivos conservan los mismos bloques, comentarios y nombres de variables.
# No publicar .env.local ni copiar sus secretos al HTML de WordPress.

# Aplicación y autenticación: un único origen para OAuth y enlaces administrativos.
# Local: http://localhost:3000. Producción: https://gestoreditorial.continental.edu.pe
# Solo origen, sin rutas. BETTER_AUTH_URL ya no se utiliza: baseURL recibe APP_URL.
APP_URL=http://localhost:3000
# Secreto privado de al menos 32 caracteres. No rotarlo al cambiar de dominio.
BETTER_AUTH_SECRET=

# Base de datos del runtime: rol restringido. Separar desarrollo y producción.
DATABASE_URL=
# Solo instalación administrativa: permite usar otro rol sin ampliar el del runtime.
# Omitir en Vercel. Se proporciona temporalmente al ejecutar pnpm db:setup.
# DATABASE_SETUP_URL=

# Cliente OAuth Web compartido por login y autorización independiente del propietario.
# Registrar <APP_URL>/api/auth/callback/google en Google Cloud para cada entorno.
# Habilitar Drive API y Gmail API. Login solicita únicamente identidad.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Token privado del propietario, del mismo cliente OAuth; no es el token del gestor.
# Scopes: drive, gmail.send y gmail.metadata; autorización con acceso offline.
GOOGLE_REFRESH_TOKEN=
# Buzón propietario usado como remitente; debe corresponder al refresh token.
GOOGLE_OWNER_EMAIL=
# ID de la carpeta privada de Drive, sin URL completa.
GOOGLE_DRIVE_FOLDER_ID=

# Orígenes de las páginas que alojan el iframe: CSP y puente postMessage.
# HTTPS, separados por comas, sin rutas ni comodines. Cambios requieren redeploy.
# Local directo no necesita padres; vacío permite solo iframe del mismo origen.
# Para probar otro padre local, usar por ejemplo http://localhost:3001.
# Producción: https://fondoeditorial.continental.edu.pe (sin añadir el gestor).
WORDPRESS_ORIGINS=
# Solo para otra página WordPress: producción ya usa la siguiente por defecto.
# No es necesaria en Vercel ni para desarrollo directo; sin query ni fragmento.
# WORDPRESS_ORDER_URL=https://fondoeditorial.continental.edu.pe/pedido/

# Cron diario (12:00 UTC): reconciliación privada de permisos Drive, sin correos.
# Secreto privado de al menos 32 caracteres; configurar en Vercel para protegerlo.
# Local solo se necesita si se invoca el endpoint protegido del cron.
CRON_SECRET=

# Build de Vercel: activar Corepack para usar pnpm@11.3.0 de package.json.
# Configurar en Vercel Production y Preview. No es una opción del runtime.
# En .env.local no activa Corepack; el equipo debe tener el pnpm declarado disponible.
ENABLE_EXPERIMENTAL_COREPACK=1

# Cuentas, campus y catálogo se administran por interfaz, sin variables adicionales.
# Guías PDF: src/resources/payment-guides/guia_pago_{universidad,instituto,mixta}.pdf
