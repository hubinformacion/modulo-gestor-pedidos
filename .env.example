# Neon Postgres connection string. Use a separate database/branch for manual review.
DATABASE_URL=

# Generate a random secret of at least 32 characters; never reuse the example.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth Web application (identity scopes for administrator sign-in).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Drive/Gmail owner credentials configured separately below.
# These are NOT required for administrator sign-in.

# Phase 4: separate owner credentials (Drive/Gmail), NOT administrator OAuth.
GOOGLE_REFRESH_TOKEN=
GOOGLE_OWNER_EMAIL=
GOOGLE_DRIVE_FOLDER_ID=
APP_URL=http://localhost:3000

# Bank accounts are managed in /admin, backed by bank_accounts in Neon.
